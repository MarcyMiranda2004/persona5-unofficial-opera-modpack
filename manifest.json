{
    "manifest_version": 3,
    "name": "Persona 5 Unofficial Opera Mod-pack",
    "version": "1.0.0",
    "description": "Una mod personalizzata a tema Persona 5 con cursori animati.",
    "developer": {
        "name": "MarcyMiranda2004"
    },
    "icons": {
        "512": "icon.png"
    },
    "mod": {
        "schema_version": 1,
        "payload": {
            "page_styles": [
                {
                    "css": [
                        "src/cursor.css"
                    ],
                    "matches": [
                        "https://*/*",
                        "http://*/*"
                    ]
                }
            ]
        }
    }
}